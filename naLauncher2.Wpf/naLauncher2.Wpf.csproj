<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Assets\na-launcher.ico</ApplicationIcon>
		<AssemblyName>naLauncher2</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\image-not-found.png" />
		<None Remove="Assets\na-launcher.ico" />
		<None Remove="Assets\na-launcher.png" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\image-not-found.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\na-launcher.ico" />
		<EmbeddedResource Include="Assets\na-launcher.png" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\naLauncher2.Core\naLauncher2.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="naLauncher2.Core" />
		<Using Include="naLauncher2.Core.Api" />
		<Using Include="naLauncher2.Core.Tools" />
	</ItemGroup>

</Project>
