<Window x:Class="naLauncher2.Wpf.SessionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        Width="560"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="SmallButtonStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3F42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3F42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
    <Border Background="#FF282C2E" BorderBrush="#FF404448" BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Cursor="SizeAll" MouseLeftButtonDown="Border_MouseLeftButtonDown" Background="Transparent">
                <TextBlock x:Name="TitleText" Text="Sessions" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="24,20,24,4"/>
                <TextBlock x:Name="SummaryText" Foreground="White" Opacity="0.6" FontSize="12" Margin="24,0,24,16" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Rectangle Height="1" Fill="#33FFFFFF" Margin="24,0,24,0"/>
                <Grid x:Name="AddRow" Margin="24,8,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewSessionStartBox" Grid.Column="0" ToolTip="Start (yyyy-MM-dd HH:mm)"
                             Foreground="White" FontSize="12" Background="Transparent"
                             BorderThickness="0,0,0,1" BorderBrush="#44FFFFFF"
                             CaretBrush="White" SelectionBrush="LightSkyBlue" Padding="0,2"/>
                    <TextBox x:Name="NewSessionDurationBox" Grid.Column="1" ToolTip="Duration: 1:30, 90 (minutes), 2h, 45m"
                             Foreground="White" FontSize="12" Background="Transparent"
                             BorderThickness="0,0,0,1" BorderBrush="#44FFFFFF"
                             CaretBrush="White" SelectionBrush="LightSkyBlue" Padding="4,2" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource SmallButtonStyle}" Text="+" ToolTip="Add a session played without tracking"
                               Foreground="LightSkyBlue" Margin="8,0,0,0"
                               MouseLeftButtonUp="AddSession_Click"/>
                </Grid>
                <Rectangle Height="1" Fill="#FF404448"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="OkButton" Style="{StaticResource ButtonStyle}" Text="OK" Foreground="LightSkyBlue" MouseLeftButtonUp="Ok_Click"/>
                    <TextBlock x:Name="CancelButton" Style="{StaticResource ButtonStyle}" Text="Cancel" MouseLeftButtonUp="Cancel_Click"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Margin="24,0,24,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="SessionsList"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
    <Border x:Name="DimOverlay" Background="#80000000" Visibility="Collapsed"/>
    </Grid>
</Window>
