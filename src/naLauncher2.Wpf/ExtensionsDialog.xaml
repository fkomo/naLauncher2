<Window x:Class="naLauncher2.Wpf.ExtensionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        Width="560"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="SmallButtonStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3F42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3F42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
    <Border Background="#FF282C2E" BorderBrush="#FF404448" BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Cursor="SizeAll" MouseLeftButtonDown="Border_MouseLeftButtonDown" Background="Transparent">
                <TextBlock x:Name="TitleText" Text="Extensions" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="24,20,24,4"/>
                <TextBlock Foreground="White" Opacity="0.6" FontSize="12" Margin="24,0,24,16" Text="Custom key / value pairs stored with the game."/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Rectangle Height="1" Fill="#33FFFFFF" Margin="24,0,24,0"/>
                <Grid x:Name="AddRow" Margin="24,8,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExtensionKeyBox" Grid.Column="0"
                             Foreground="White" FontSize="12" Background="Transparent"
                             BorderThickness="0,0,0,1" BorderBrush="#44FFFFFF"
                             CaretBrush="White" SelectionBrush="LightSkyBlue" Padding="0,2"/>
                    <TextBox x:Name="ExtensionValueBox" Grid.Column="1"
                             Foreground="White" FontSize="12" Background="Transparent"
                             BorderThickness="0,0,0,1" BorderBrush="#44FFFFFF"
                             CaretBrush="White" SelectionBrush="LightSkyBlue" Padding="4,2" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource SmallButtonStyle}" Text="+"
                               Foreground="LightSkyBlue" Margin="8,0,0,0"
                               MouseLeftButtonUp="AddExtension_Click"/>
                </Grid>
                <Rectangle Height="1" Fill="#FF404448"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="OkButton" Style="{StaticResource ButtonStyle}" Text="OK" Foreground="LightSkyBlue" MouseLeftButtonUp="Ok_Click"/>
                    <TextBlock x:Name="CancelButton" Style="{StaticResource ButtonStyle}" Text="Cancel" MouseLeftButtonUp="Cancel_Click"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Margin="24,0,24,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="ExtensionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Key}" Foreground="White" Opacity="0.5"
                                           FontSize="12" Padding="0,2"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="White" Opacity="0.8"
                                           FontSize="12" Padding="4,2" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                <TextBlock Grid.Column="2" Text="✕" Tag="{Binding Key}"
                                           Foreground="White" Opacity="0.4" FontSize="11" Padding="8,2,0,2"
                                           Cursor="Hand" MouseLeftButtonUp="RemoveExtension_Click">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="readonly">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
    <Border x:Name="DimOverlay" Background="#80000000" Visibility="Collapsed"/>
    </Grid>
</Window>
